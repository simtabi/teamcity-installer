# TeamCity Installer — stack configuration (example)
#
# THIS FILE IS TRACKED. It documents every setting with placeholder values and
# must never contain a real credential.
#
# Your actual configuration is stack/.env, which is gitignored and written by the
# setup wizard. Copy this only if you prefer to configure by hand:
#
#     cp stack/.env.example stack/.env
#     $EDITOR stack/.env          # fill in the blanks
#     ./tc up                     # values are validated before anything runs
#
# Values are single-quoted. Keep them that way — TC_MEM_OPTS contains spaces and
# would otherwise parse as two separate things.
#
# The sections below mirror what the wizard writes, in the same order. A test
# asserts the two files carry the same keys in the same sequence.

# --- identity -----------------------------------------------------------------
# TC_STACK names the Compose project, so every container, volume and network is
# prefixed with it. Renaming does not move data; the old volumes stay behind.
#
# TC_PORT must be 1024 or above: TeamCity runs as uid 1000 in the container and
# cannot bind privileged ports. TC_TZ matters because the agent image hardcodes
# Europe/London, which would otherwise put every build timestamp in the wrong
# zone.

TC_STACK='teamcity'
TC_VERSION='2026.1.3'
TC_PORT='8111'
TC_TZ='UTC'

# --- database -----------------------------------------------------------------
# TC_DB is 'postgres' for a dedicated container, or 'hsqldb' for TeamCity's
# bundled database, which JetBrains support for evaluation only.
#
# LEAVE THE PASSWORD EMPTY. The wizard generates one. If you are filling this in
# by hand, generate your own and never commit it:
#
#     openssl rand -base64 64 | tr -dc 'A-Za-z0-9._-' | cut -c1-32
#
# It cannot contain $ ` " ' or a backslash: those break .env interpolation and
# the JDBC URL. Minimum 16 characters.

TC_DB='postgres'
TC_PG_VERSION='17'
TC_PG_DB='teamcity'
TC_PG_USER='teamcity'
TC_PG_PASSWORD=''
TC_JDBC_VERSION='42.7.13'

# --- build agents -------------------------------------------------------------
# Three agents is what TeamCity's free Professional licence covers; above that
# the server pauses the entire build queue.
#
# TC_AGENT_IMAGE is 'full' or 'minimal'. TC_AGENT_DOCKER is 'none', 'dind' or
# 'socket' — either Docker mode forces the full image, since the minimal one has
# no docker binary at all.

TC_AGENTS='3'
TC_AGENT_IMAGE='full'
TC_AGENT_DOCKER='none'

# --- first administrator ------------------------------------------------------
# Created automatically the first time the server comes up with no accounts.
#
# LEAVE THE PASSWORD EMPTY unless you need a known value, as CI would. Empty
# means one is generated and shown once rather than kept on disk, where it would
# go stale as soon as it changed in the UI.

TC_ADMIN_USER='admin'
TC_ADMIN_PASSWORD=''

# --- resources ----------------------------------------------------------------
# The whole JVM options string is validated, not just -Xmx. Minimum 1g, and you
# are warned above 70% of the Docker VM's memory.

TC_MEM_OPTS='-Xmx2g -XX:ReservedCodeCacheSize=640m'

# --- housekeeping -------------------------------------------------------------
# TC_BACKUP_KEEP bounds the archives in backups/, pruned oldest-first after each
# successful backup. TC_LOG_LEVEL is DEBUG, INFO, WARN, ERROR or OFF.

TC_BACKUP_KEEP='5'
TC_LOG_LEVEL='INFO'

# --- compose ------------------------------------------------------------------
# Read directly by Docker Compose. Keep it equal to TC_STACK.

COMPOSE_PROJECT_NAME='teamcity'
