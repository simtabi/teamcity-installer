# Example configuration for the TeamCity Installer.
#
# THIS FILE IS TRACKED. It documents every setting with placeholder values and
# must never contain a real credential.
#
# Your actual configuration lives in stack/.env, which is gitignored and written
# by the setup wizard. Copy this file only if you prefer to configure by hand:
#
#     cp stack/.env.example stack/.env
#     $EDITOR stack/.env          # fill in the blanks
#     ./tc up                     # values are validated before anything runs
#
# Values are single-quoted. Keep them that way: TC_MEM_OPTS contains spaces and
# would otherwise parse as two separate things.

# --- identity -----------------------------------------------------------------
TC_STACK='teamcity'
TC_VERSION='2026.1.3'
TC_PORT='8111'
TC_TZ='UTC'

# --- database -----------------------------------------------------------------
# 'postgres' for a dedicated container, or 'hsqldb' for TeamCity's bundled
# database (JetBrains support that for evaluation only).
TC_DB='postgres'
TC_PG_VERSION='17'
TC_PG_DB='teamcity'
TC_PG_USER='teamcity'

# LEAVE EMPTY. The wizard generates one; if you are filling this in by hand,
# generate your own and never commit it:
#
#     openssl rand -base64 64 | tr -dc 'A-Za-z0-9._-' | cut -c1-32
#
# At least 16 characters, and no $ ` " ' or backslash — those break .env
# interpolation and the JDBC URL.
TC_PG_PASSWORD=''

TC_JDBC_VERSION='42.7.13'

# --- agents -------------------------------------------------------------------
# Three is what TeamCity's free Professional licence covers. Above that the
# server pauses the entire build queue.
TC_AGENTS='3'
TC_AGENT_IMAGE='full'
TC_AGENT_DOCKER='none'

# Kept only so an older stack/.env still parses. TeamCity's documented
# agent-auto-authorize property does not work on 2026.1.3, so agents are
# authorized explicitly via  ./tc authorize.  Leave both as they are.
TC_AGENT_AUTO_AUTHORIZE='0'
TC_AGENT_AUTH_TOKEN=''

# --- first administrator ------------------------------------------------------
# Created automatically the first time the server comes up with no accounts.
# Leave the password empty and one is generated and shown once, rather than
# living on disk. Set it here only if you need a known value (CI, for example).
TC_ADMIN_USER='admin'
TC_ADMIN_PASSWORD=''

# --- resources ----------------------------------------------------------------
TC_MEM_OPTS='-Xmx2g -XX:ReservedCodeCacheSize=640m'

# --- housekeeping -------------------------------------------------------------
TC_BACKUP_KEEP='5'
TC_LOG_LEVEL='INFO'

# Compose reads this directly; keep it equal to TC_STACK.
COMPOSE_PROJECT_NAME='teamcity'
